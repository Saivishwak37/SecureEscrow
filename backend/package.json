{
  "name": "securelance",
  "version": "1.0.0",
  "description": "SecureEscrow - General-purpose escrow transaction platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:postgres": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:test:migrate": "node scripts/test-database.js deploy",
    "db:test:status": "node scripts/test-database.js status",
    "db:test:integrity": "node --test scripts/verify-test-integrity.js",
    "db:test:core": "node --test scripts/verify-core-persistence.js",
    "db:test:finance": "node --test scripts/verify-financial-persistence.js",
    "db:test:disputes": "node --test scripts/verify-dispute-persistence.js"
  },
  "keywords": [
    "escrow",
    "payment",
    "transaction",
    "ledger"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "prisma": "6.19.3",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "jest": "^29.5.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  }
}
